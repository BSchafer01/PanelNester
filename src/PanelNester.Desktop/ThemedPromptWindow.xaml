<Window x:Class="PanelNester.Desktop.ThemedPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OptiFab"
        Width="840"
        SizeToContent="Height"
        MinHeight="260"
        Background="Transparent"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
    <Window.Resources>
        <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#151515" />
        <SolidColorBrush x:Key="DialogButtonBrush" Color="#2B2B2C" />
        <SolidColorBrush x:Key="DialogButtonHoverBrush" Color="#343436" />
        <SolidColorBrush x:Key="DialogButtonPressedBrush" Color="#3E3E40" />
        <SolidColorBrush x:Key="DialogCloseHoverBrush" Color="#2A2A2A" />
        <SolidColorBrush x:Key="DialogBorderBrush" Color="#2B2D2F" />
        <SolidColorBrush x:Key="DialogPrimaryTextBrush" Color="#ECE8E3" />
        <SolidColorBrush x:Key="DialogSecondaryTextBrush" Color="#B2ACA6" />
        <SolidColorBrush x:Key="DialogAccentBrush" Color="#47D8FF" />

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource DialogPrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource DialogButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource DialogButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleBarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DialogCloseHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DialogActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource DialogPrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource DialogButtonBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource DialogButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource DialogButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource DialogBackgroundBrush}"
            BorderBrush="{StaticResource DialogBorderBrush}"
            BorderThickness="1"
            CornerRadius="24"
            Margin="12"
            SnapsToDevicePixels="True">
        <Grid Margin="24,22,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="DialogTitleTextBlock"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource DialogAccentBrush}"
                           FontSize="13"
                           FontWeight="Bold"
                           Text="UNSAVED CHANGES" />

                <Button Grid.Column="1"
                        Click="CloseButton_Click"
                        Style="{StaticResource CloseTitleBarButtonStyle}"
                        ToolTip="Close">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="10"
                               Text="&#xE8BB;" />
                </Button>
            </Grid>

            <Border x:Name="ToneBadgeBorder"
                    Grid.Row="1"
                    Width="0"
                    Height="0"
                    Visibility="Collapsed">
                <TextBlock x:Name="ToneBadgeTextBlock"
                           Text="!" />
            </Border>

            <StackPanel Grid.Row="1"
                        Margin="0,18,0,0">
                <TextBlock x:Name="HeadlineTextBlock"
                           Foreground="{StaticResource DialogPrimaryTextBrush}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Text="Save before continuing?"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="MessageTextBlock"
                           Margin="0,26,0,0"
                           Foreground="{StaticResource DialogSecondaryTextBrush}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           LineHeight="24"
                           Text="Dialog message."
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="3"
                        Margin="0,34,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button x:Name="PrimaryButton"
                        Click="PrimaryButton_Click"
                        Style="{StaticResource DialogActionButtonStyle}"
                        Content="YES" />
                <Button x:Name="SecondaryButton"
                        Click="SecondaryButton_Click"
                        Margin="12,0,0,0"
                        Style="{StaticResource DialogActionButtonStyle}"
                        Content="NO" />
                <Button x:Name="CancelButton"
                        Click="CancelButton_Click"
                        Margin="12,0,0,0"
                        Style="{StaticResource DialogActionButtonStyle}"
                        Content="CANCEL" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
